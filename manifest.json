{
    "manifest_version": 3,
    "name": "Privacy Agent",
    "version": "1.0.0",
    "description": "A privacy-preserving browser AI agent",
    "permissions": [
        "activeTab",
        "scripting",
        "storage",
        "unlimitedStorage",
        "offscreen"
    ],
    "host_permissions": [
        "http://localhost:3000/*"
    ],
    "background": {
        "service_worker": "background.js"
    },
    "action": {
        "default_popup": "popup.html"
    },
    "content_security_policy": {
        "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'"
    },
    "web_accessible_resources": [
        {
            "resources": [
                "node_modules/tesseract.js/dist/worker.min.js",
                "node_modules/tesseract.js-core/*",
                "tessdata/*",
                "models/*",
                "assets/*",
                "node_modules/onnxruntime-web/dist/*"
            ],
            "matches": [
                "<all_urls>"
            ]
        }
    ],
    "content_scripts": [
        {
            "matches": [
                "<all_urls>"
            ],
            "js": [
                "ocr.js",
                "content.js"
            ]
        }
    ]
}